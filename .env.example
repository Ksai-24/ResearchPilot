# Aira configuration (Primary: Groq Ultra-Fast 120B Engine / TokenRouter / Gemini)
AIRA_API_KEY=gsk_your_groq_api_key_here
AIRA_BASE_URL=https://api.groq.com/openai/v1
# Groq:          https://api.groq.com/openai/v1 (model: openai/gpt-oss-120b)
# Gemini:        https://generativelanguage.googleapis.com/v1beta/openai/ (model: gemini-flash-latest)
# OpenRouter:    https://openrouter.ai/api/v1 (model: nvidia/nemotron-3.5-lightning:free)
# TokenRouter:   https://api.tokenrouter.com/v1 (model: z-ai/glm-5-turbo)

# Model for Aira (the agent)
AIRA_MODEL=openai/gpt-oss-120b
AIRA_JUDGE_MODEL=openai/gpt-oss-120b
AIRA_FALLBACK_MODELS=openai/gpt-oss-20b

# Agent tuning
AIRA_MAX_TOOL_ROUNDS=8
AIRA_TEMPERATURE=0.2
AIRA_MAX_TOKENS=4096

# --- Secondary API (Google Gemini 3.8 Flash - Multimodal PDF Vision & Deep Context) ---
AIRA_SECONDARY_API_KEY=AQ_your_google_ai_key_here
AIRA_SECONDARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AIRA_SECONDARY_MODEL=gemini-flash-latest

# --- Tertiary API (OpenRouter Free Resilient Failover) ---
AIRA_TERTIARY_API_KEY=sk-or-v1-your-openrouter-key-here
AIRA_TERTIARY_BASE_URL=https://openrouter.ai/api/v1
AIRA_TERTIARY_MODEL=nvidia/nemotron-3.5-lightning:free

# Google AI Studio Direct Key
GOOGLE_AI_KEY=AQ_your_google_ai_key_here

# Aux API Key (Speech-to-Text Whisper Large v3 / Voice)
AIRA_AUX_KEY=sk-or-v1-your-aux-key-here

# --- Load Balancing & Concurrency (Tuned for 50 Concurrent Users) ---
AIRA_MAX_CONCURRENT_REQUESTS=50
AIRA_HIGH_TRAFFIC_CONCURRENCY=10
AIRA_HIGH_TRAFFIC_RPM=60

# --- MySQL Database & Memory Management ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=chat_app
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=chat_app
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/chat_app
USE_MYSQL=1

# Google Sign-In OAuth Client ID (Optional)
GOOGLE_CLIENT_ID=
