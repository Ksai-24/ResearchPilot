# Aira configuration — copy to .env and fill in your key.

# Required: any OpenAI-compatible provider (OpenAI, Groq, OpenRouter, Together...)
AIRA_API_KEY=sk-your-key-here

# Provider base URL (defaults work for OpenAI; change for Groq/OpenRouter/etc.)
AIRA_BASE_URL=https://api.openai.com/v1
# Groq example:    https://api.groq.com/openai/v1
# OpenRouter:       https://openrouter.ai/api/v1

# Model for Aira (the agent)
AIRA_MODEL=gpt-4o-mini

# Model for the judge in eval runs (can be the same)
AIRA_JUDGE_MODEL=gpt-4o-mini

# Agent tuning
AIRA_MAX_TOOL_ROUNDS=8
AIRA_TEMPERATURE=0.2
# Set empty (AIRA_TEMPERATURE=) for reasoning models that reject temperature.
# AIRA_MAX_TOKENS=4096

# --- Secondary API (High Traffic Failover) ---
# Used automatically when primary traffic is high or primary hits rate limits
AIRA_SECONDARY_API_KEY=
AIRA_SECONDARY_BASE_URL=https://openrouter.ai/api/v1
AIRA_SECONDARY_MODEL=google/gemini-2.5-flash-lite

# --- Load Balancing & Concurrency ---
AIRA_MAX_CONCURRENT_REQUESTS=10
AIRA_HIGH_TRAFFIC_CONCURRENCY=3
AIRA_HIGH_TRAFFIC_RPM=25

# --- MySQL Database & Memory Management ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=aira_db
MYSQL_POOL_SIZE=5
MYSQL_POOL_RECYCLE=1800
