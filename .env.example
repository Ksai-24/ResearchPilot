# Aira configuration (Primary: TokenRouter / OpenRouter / OpenAI compatible)
AIRA_API_KEY=sk-your-tokenrouter-or-openrouter-key
AIRA_BASE_URL=https://api.tokenrouter.com/v1
# TokenRouter:   https://api.tokenrouter.com/v1 (model: z-ai/glm-5-turbo)
# OpenRouter:    https://openrouter.ai/api/v1 (model: nvidia/nemotron-3.5-lightning:free)
# Groq:          https://api.groq.com/openai/v1 (model: llama-3.3-70b-versatile)
# Gemini:        https://generativelanguage.googleapis.com/v1beta/openai/ (model: gemini-2.0-flash)

# Model for Aira (the agent)
AIRA_MODEL=z-ai/glm-5-turbo
AIRA_JUDGE_MODEL=z-ai/glm-5-turbo
AIRA_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,nex-agi/nex-n2.5-pro:free

# Agent tuning
AIRA_MAX_TOOL_ROUNDS=8
AIRA_TEMPERATURE=0.2
AIRA_MAX_TOKENS=4096

# --- Secondary API (High Traffic & Quota Failover) ---
# Used automatically when primary hits quota, rate limits, or under high concurrent traffic
AIRA_SECONDARY_API_KEY=sk-your-secondary-key
AIRA_SECONDARY_BASE_URL=https://openrouter.ai/api/v1
AIRA_SECONDARY_MODEL=nvidia/nemotron-3.5-lightning:free

# Aux API Key (Speech / STT / TTS)
AIRA_AUX_KEY=

# --- Load Balancing & Concurrency ---
AIRA_MAX_CONCURRENT_REQUESTS=10
AIRA_HIGH_TRAFFIC_CONCURRENCY=3
AIRA_HIGH_TRAFFIC_RPM=25

# --- MySQL Database & Memory Management ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=aira_db
MYSQL_POOL_SIZE=5
MYSQL_POOL_RECYCLE=1800
