# Aira configuration (OpenRouter)
# Primary: gpt-oss-20b (free, proven reliable tool-calling — passed 3/3 eval + all live tests)
# Fallback 1: Google Gemini 2.5 Flash Lite
# Fallback 2: Mistral Nemo
AIRA_API_KEY=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
AIRA_BASE_URL=https://openrouter.ai/api/v1
AIRA_MODEL=openai/gpt-oss-20b
AIRA_JUDGE_MODEL=openai/gpt-oss-20b
AIRA_FALLBACK_MODELS=google/gemini-2.5-flash-lite,mistralai/mistral-nemo
AIRA_MAX_TOOL_ROUNDS=8
AIRA_TEMPERATURE=0.2
AIRA_MAX_TOKENS=4096

# Secondary API for High Traffic (auto-routes when traffic is high or primary hits rate limit)
AIRA_SECONDARY_API_KEY=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
AIRA_SECONDARY_BASE_URL=https://openrouter.ai/api/v1
AIRA_SECONDARY_MODEL=google/gemini-2.5-flash-lite

# Load balancing & Concurrency thresholds (tuned for 50 concurrent users)
AIRA_MAX_CONCURRENT_REQUESTS=50
AIRA_HIGH_TRAFFIC_CONCURRENCY=10
AIRA_HIGH_TRAFFIC_RPM=60

# MySQL Database Memory Management & Auth (ORM Framework Config)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Naidu@2728
DB_NAME=chat_app
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=Naidu@2728
MYSQL_DATABASE=chat_app
DATABASE_URL=mysql+pymysql://root:Naidu%402728@127.0.0.1:3306/chat_app
USE_MYSQL=1

# Google Sign-In OAuth Client ID (Optional: leave empty for standard or demo mode)
GOOGLE_CLIENT_ID=

